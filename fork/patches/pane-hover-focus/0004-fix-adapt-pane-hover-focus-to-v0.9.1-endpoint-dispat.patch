 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/client/shell/tests/mouse_selection.rs b/src/client/shell/tests/mouse_selection.rs
index 16b17d8e..1c1dbb7a 100644
--- a/src/client/shell/tests/mouse_selection.rs
